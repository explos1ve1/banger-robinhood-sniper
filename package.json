{
  "name": "banger-sniper",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "BANGER — self-hosted Robinhood Chain sniper with PONS V2 curves, Uniswap V3 discovery and V4 exits.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "banger": "dist/cli.js"
  },
  "scripts": {
    "demo": "node --import tsx src/cli.ts demo",
    "start": "node --import tsx src/cli.ts run",
    "doctor": "node --import tsx src/cli.ts doctor",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "docs:render": "node --import tsx scripts/render-docs.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\""
  },
  "dependencies": {
    "chalk": "5.6.2",
    "dotenv": "16.6.1",
    "ethers": "^6.15.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@ethereumjs/util": "8.1.0",
    "@foundry-rs/anvil": "1.7.1",
    "@ganache/core": "0.10.2",
    "@openzeppelin/contracts": "5.0.2",
    "@types/node": "^22.18.0",
    "@uniswap/swap-router-contracts": "1.3.1",
    "@uniswap/universal-router": "2.1.0",
    "@uniswap/v3-core": "1.0.1",
    "@uniswap/v3-periphery": "1.4.4",
    "@uniswap/v4-core": "1.0.2",
    "@uniswap/v4-periphery": "1.0.3",
    "prettier": "3.6.2",
    "solc": "0.8.30",
    "solc-0-8-26": "npm:solc@0.8.26",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3"
  }
}
