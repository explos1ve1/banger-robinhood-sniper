# Read-only first. Paper mode uses real quotes without signing transactions.
MODE=watch
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
# Published V3 deployment candidates. Doctor MUST validate these against your RPC.
# See docs/NETWORKS.md for provenance and supported launch generations.
V3_FACTORY=0x1f7d7550B1b028f7571E69A784071F0205FD2EfA
V3_ROUTER=0xCaf681a66D020601342297493863E78C959E5cb2
V3_QUOTER=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7
WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
ROUTER_KIND=auto

# Scan both compatible V3 pools (including PONS V1) and native-ETH PONS V2 launches.
# Existing .env files keep V3-only behavior until VENUES is explicitly set.
VENUES=both
PONS_V2_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
V4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
V4_ROUTER=0x8876789976decbfcbbbe364623c63652db8c0904
V4_ROUTER_VERSION=2.1.1
V4_QUOTER=0x8dc178efb8111bb0973dd9d722ebeff267c98f94
V4_STATE_VIEW=0xf3334192d15450cdd385c8b70e03f9a6bd9e673b
PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
PONS_MIN_REAL_ETH=0.01
PONS_MAX_FEE_BPS=500
PONS_MAX_SNIPE_TAX_BPS=0
PONS_MAX_PROGRESS_BPS=8500
PONS_EXIT_PROGRESS_BPS=9500
FEE_TIERS=10000
BUY_ETH=0.001
MAX_SESSION_SPEND_ETH=0.01
MAX_OPEN_POSITIONS=3
MAX_SESSION_LOSS_ETH=0.003
MIN_POOL_WETH_ETH=0.05
SLIPPAGE_BPS=100
MAX_PRICE_MOVE_BPS=500
TAKE_PROFIT_BPS=3000
STOP_LOSS_BPS=1500
MAX_HOLD_SECONDS=900
MAX_GAS_PER_TX_ETH=0.001
MAX_FEE_GWEI=3
PAPER_START_ETH=0.1
POLL_MS=2000
CONFIRMATIONS=3
LOOKBACK_BLOCKS=1000
LOG_CHUNK_BLOCKS=250
MIN_POOL_AGE_BLOCKS=3
MAX_POOL_AGE_SECONDS=300
RPC_TIMEOUT_MS=10000
TX_WAIT_MS=45000
DATA_DIR=./data
# Live trading requires BOTH MODE=live and LIVE_ACK=I_ACCEPT_REAL_TRADES.
# Put a dedicated wallet's key only in your local .env. Never commit or share it.
PRIVATE_KEY=
LIVE_ACK=
